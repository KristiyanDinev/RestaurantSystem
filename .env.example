# Copy this file to .env and replace every placeholder before deployment.
APP_PORT=7278

# Optional custom SQL initialization file. Docker automatically installs the
# pinned CountryStateCity dataset when these tables are empty.
# STARTUP_SQL_FILE=/app/startup.sql

POSTGRES_DB=Restaurant
POSTGRES_USER=RestaurantUser
POSTGRES_PASSWORD=replace-with-a-long-database-password

ENCRYPTION_KEY=replace-with-a-long-random-encryption-key
JWT_KEY=replace-with-a-long-random-jwt-key
HASH_SALT=replace-with-a-long-random-salt

RABBITMQ_DEFAULT_USER=restaurant
RABBITMQ_DEFAULT_PASS=replace-with-a-long-rabbitmq-password

# Optional SMTP settings
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_FROM_EMAIL=
# SMTP_APP_PASSWORD=
